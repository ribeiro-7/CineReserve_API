# =========================
# Database Settings
# =========================

DB_NAME=nome_do_seu_bd
DB_USER=usuario_do_bd
DB_PASSWORD=senha_do_bd
DB_HOST=db
DB_PORT=5432

# =========================
# Django Settings
# =========================

SECRET_KEY=CHANGE-ME

# Obrigatório em local para completar pagamentos (sem https:// no host)
# NGROK_HOST=abc123.ngrok-free.dev

# =========================
# Celery / Redis
# =========================

CELERY_BROKER_URL=redis://redis:6379/0

# =========================
# Flutterwave Settings
# =========================

FLW_PUBLIC_KEY=CHANGE-ME
FLW_SECRET_KEY=CHANGE-ME
FLW_ENCRYPTION_KEY=CHANGE-ME
FLW_SECRET_HASH=CHANGE-ME
# Use a URL pública do ngrok em local, ex.: https://abc123.ngrok-free.dev/payments/callback/
FLW_REDIRECT_URL=CHANGE-ME